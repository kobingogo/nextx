{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextx.local/schemas/cluster-input.v1.json",
  "title": "NextX Topic Cluster Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "account_key", "cluster_run_id", "clusters", "adjacent_candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "account_key": {"const": "primary"},
    "cluster_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "clusters": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_ids", "display_title", "proposition", "kind", "confidence", "why_now", "target_reader", "candidate_angle", "recommended_next_step", "evidence"],
        "properties": {
          "kind": {"enum": ["event", "evergreen"]},
          "signal_ids": {"type": "array", "minItems": 2, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "display_title": {"type": "string", "minLength": 1, "maxLength": 200},
          "proposition": {"type": "string", "minLength": 1, "maxLength": 500},
          "confidence": {"enum": ["high", "medium", "low"]},
          "why_now": {"type": "string", "minLength": 1, "maxLength": 500},
          "target_reader": {"type": "string", "minLength": 1, "maxLength": 300},
          "candidate_angle": {"type": "string", "minLength": 1, "maxLength": 500},
          "recommended_next_step": {"enum": ["watch", "topic_card", "quote", "reply", "original"]},
          "evidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signal_id", "quote", "role", "translation_status"],
              "properties": {
                "signal_id": {"type": "string", "minLength": 1, "maxLength": 256},
                "quote": {"type": "string", "minLength": 1, "maxLength": 1000},
                "role": {"enum": ["support", "counter"]},
                "translation_status": {"enum": ["original", "inference"]}
              }
            }
          }
        }
      }
    },
    "adjacent_candidates": {
      "type": "array", "maxItems": 24,
      "items": {"type": "object", "additionalProperties": false, "required": ["signal_ids", "reason"], "properties": {
        "signal_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300}
      }}
    }
  }
}
