{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextx.local/schemas/collector-envelope.v1.json",
  "title": "NextX Collector Envelope v1",
  "type": "object",
  "required": ["schema_version", "account_key", "collector", "retrieved_at", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "account_key": {"const": "primary"},
    "collector": {"type": "string", "minLength": 1},
    "query": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "text", "source_confidence"],
        "anyOf": [
          {"required": ["source_id"]},
          {"required": ["source_url"]}
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "source_url": {"type": ["string", "null"]},
          "author_handle": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "text": {"type": "string", "minLength": 1},
          "metrics": {"type": "object"},
          "media": {"type": "array"},
          "source_confidence": {"enum": ["high", "medium", "low"]},
          "discovery_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
