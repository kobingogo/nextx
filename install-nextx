#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python_bin=${NEXTX_PYTHON:-}
if [ -z "$python_bin" ]; then
  for candidate in python3.13 python3.12 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
      python_bin=$candidate
      break
    fi
  done
fi
if [ -z "$python_bin" ]; then
  echo "NextX requires Python 3.11 or newer; set NEXTX_PYTHON to a compatible interpreter." >&2
  exit 1
fi
exec "$python_bin" "$script_dir/skills/nextx/scripts/bootstrap.py" --output human "$@" --source "$script_dir"
